---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const slides = await getCollection('slides');
const videos = await getCollection('videos');
const glyphs = ['▲', '◆', '●', '■', '✦', '⬢'];
const channel = 'https://www.youtube.com/@MLStudentOdyssey';
---
<Base title="Teaching" description="Teaching material I made for my YouTube channel and for teaching programming in high school.">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Teaching</p>
      <h1>Teaching</h1>
      <p class="lede">
        Teaching material I made for my YouTube channel and for teaching programming in high school.
        The slides are in Italian; the videos are in English.
      </p>
    </header>

    <section class="block">
      <div class="block-head">
        <h2>Videos</h2>
        <a class="more" href={channel} target="_blank" rel="noopener">YouTube channel ↗</a>
      </div>
      <div class="videos">
        {videos.map(({ data: v }) => (
          <figure class="video">
            <button class="facade" type="button" data-youtube={v.youtube} data-start={v.start ?? 0} aria-label={`Play: ${v.title}`}>
              <img src={`https://i.ytimg.com/vi/${v.youtube}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
              <span class="play" aria-hidden="true"></span>
            </button>
            <figcaption>
              <a href={`https://www.youtube.com/watch?v=${v.youtube}${v.start ? `&t=${v.start}s` : ''}`} target="_blank" rel="noopener">{v.title}</a>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="block" data-slides>
      <div class="block-head">
        <h2>Slides</h2>
        <div class="controls">
          <input class="search" type="search" placeholder="Search slides…" aria-label="Search slides" data-search />
          <button class="arrow" type="button" aria-label="Previous slides" data-prev>←</button>
          <button class="arrow" type="button" aria-label="Next slides" data-next>→</button>
        </div>
      </div>
      <div class="track" data-track>
        {slides.map(({ data: s }, i) => (
          <a
            class="card deck"
            href={s.url}
            target="_blank"
            rel="noopener"
            data-text={[s.title, s.topic, s.description].filter(Boolean).join(' ').toLowerCase()}
          >
            <div class="thumb" style={`--h:${(i * 37) % 360}`}>
              <span class="g" aria-hidden="true">{glyphs[i % glyphs.length]}</span>
              {s.topic && <span class="kind mono">{s.topic}</span>}
            </div>
            <div class="info">
              <h3>{s.title}</h3>
              {s.description && <p>{s.description}</p>}
            </div>
          </a>
        ))}
      </div>
      <p class="empty" hidden data-empty>No slides match your search.</p>
    </section>
  </div>
</Base>

<script>
  // Videos: load the real YouTube player only when someone clicks, so the page stays light.
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.facade')) {
    btn.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.youtube}?autoplay=1&start=${btn.dataset.start}`;
      frame.title = btn.getAttribute('aria-label')?.replace('Play: ', '') ?? 'YouTube video';
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      frame.allowFullscreen = true;
      btn.replaceWith(frame);
    });
  }

  // Slides: a scrolling carousel with a search filter.
  const root = document.querySelector<HTMLElement>('[data-slides]');
  if (root) {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const search = root.querySelector<HTMLInputElement>('[data-search]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const cards = [...track.querySelectorAll<HTMLElement>('.deck')];

    const updateArrows = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max;
    };
    const page = (dir: number) => track.scrollBy({ left: dir * track.clientWidth, behavior: 'smooth' });

    prev.addEventListener('click', () => page(-1));
    next.addEventListener('click', () => page(1));
    track.addEventListener('scroll', updateArrows, { passive: true });
    window.addEventListener('resize', updateArrows);

    search.addEventListener('input', () => {
      const words = search.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const card of cards) {
        const match = words.every((w) => card.dataset.text!.includes(w));
        card.hidden = !match;
        if (match) shown++;
      }
      empty.hidden = shown > 0;
      track.scrollLeft = 0;
      updateArrows();
    });
    updateArrows();
  }
</script>

<style>
  .block {
    padding: 36px 0 28px;
    border-top: 1px solid var(--border);
  }
  .block-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }
  .block-head h2 {
    margin: 0;
    font-size: 1.6rem;
  }

  .videos {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
  }
  .video {
    margin: 0;
  }
  .facade,
  .video iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: 12px;
    overflow: hidden;
    background: #000;
  }
  .facade {
    position: relative;
    padding: 0;
    cursor: pointer;
    border: 1px solid var(--border);
  }
  .facade img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease, opacity 0.3s ease;
    opacity: 0.9;
  }
  .facade:hover img {
    transform: scale(1.03);
    opacity: 1;
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 64px;
    height: 44px;
    margin: -22px 0 0 -32px;
    border-radius: 12px;
    background: rgb(0 0 0 / 0.7);
    transition: background 0.2s ease;
  }
  .play::after {
    content: '';
    position: absolute;
    left: 26px;
    top: 13px;
    border-style: solid;
    border-width: 9px 0 9px 15px;
    border-color: transparent transparent transparent #fff;
  }
  .facade:hover .play {
    background: #e62117;
  }
  .video figcaption {
    margin-top: 10px;
    font-size: 0.95rem;
    font-weight: 550;
  }
  .video figcaption a {
    color: var(--text);
    text-decoration: none;
  }
  .video figcaption a:hover {
    color: var(--accent);
  }

  .controls {
    display: flex;
    gap: 8px;
    align-items: center;
    flex: 1 1 260px;
    justify-content: flex-end;
  }
  .search {
    flex: 0 1 280px;
    min-width: 0;
    font: inherit;
    font-size: 0.92rem;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text);
  }
  .search:focus {
    outline: none;
    border-color: var(--accent);
  }
  .arrow {
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text);
    font-size: 1rem;
    cursor: pointer;
  }
  .arrow:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }
  .arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  /* Four cards per view on wide screens, fewer on smaller ones. */
  .track {
    --per-view: 4;
    --gap: 16px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-bottom: 4px;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  @media (max-width: 1000px) {
    .track { --per-view: 3; }
  }
  @media (max-width: 720px) {
    .track { --per-view: 2; }
  }
  @media (max-width: 480px) {
    .track { --per-view: 1.2; }
  }
  .deck {
    overflow: hidden;
    scroll-snap-align: start;
  }
  .deck[hidden] {
    display: none;
  }
  .thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    background:
      radial-gradient(circle at 20% 120%, hsl(var(--h) 80% 60% / 0.55), transparent 60%),
      radial-gradient(circle at 110% 0%, hsl(calc(var(--h) + 60) 85% 60% / 0.45), transparent 55%),
      var(--surface-2);
    display: grid;
    place-items: center;
    border-bottom: 1px solid var(--border);
  }
  .g {
    font-size: 2.6rem;
    color: var(--text);
    opacity: 0.75;
    transition: transform 0.3s ease;
  }
  .deck:hover .g {
    transform: scale(1.12) rotate(-6deg);
  }
  .kind {
    position: absolute;
    top: 10px;
    left: 10px;
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 6px;
    background: var(--bg);
    color: var(--text-soft);
  }
  .info {
    padding: 14px 16px 16px;
  }
  .info h3 {
    margin: 0;
    font-size: 1.02rem;
  }
  .info p {
    margin: 6px 0 0;
    font-family: var(--font-hand);
    font-size: 1.02rem;
    line-height: 1.4;
    color: var(--muted);
  }
  .empty {
    color: var(--muted);
    margin: 8px 0 0;
  }
</style>

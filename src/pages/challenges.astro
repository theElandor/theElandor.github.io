---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const page = (await getEntry('pages', 'challenges'))!;
const { Content } = await render(page);
---
<Base title="Yet Another Python Challenge" description="A coding challenge I created for high-school students.">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Challenge · YAPC</p>
      <h1>Yet Another<br />Python Challenge</h1>
    </header>
    <div class="split">
      <div class="prose"><Content /></div>
      <div class="term card" role="img" aria-label="How the challenge works">
        <div class="dots"><span></span><span></span><span></span><em class="mono">yapc — intro</em></div>
        <pre class="mono"><span class="c"># How it works</span>
Each level is one puzzle.
Solve it, then put your answer
in the URL to reach the next level:

<span class="u">theelandor.github.io/challenge/</span><span class="a">&lt;answer&gt;</span><span class="u">.html</span>

<span class="c"># Level 0</span>
<span class="p">&gt;&gt;&gt;</span> 91023 * 31233
<span class="cursor">▍</span></pre>
      </div>
    </div>
    <div class="cta">
      <a class="btn primary" href="/challenge/intro.html">Start the challenge →</a>
      <span class="mono hint">No spoilers here. Good luck.</span>
    </div>
  </div>
</Base>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 480px);
    gap: 48px;
    align-items: start;
  }
  .prose :global(h2) {
    display: none;
  }
  .term {
    overflow: hidden;
    background: #0d0d16;
    border-color: rgba(255, 255, 255, 0.1);
    color: #d9d9e6;
  }
  .dots {
    display: flex;
    gap: 7px;
    align-items: center;
    padding: 12px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .dots span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #ff5f57;
  }
  .dots span:nth-child(2) {
    background: #febc2e;
  }
  .dots span:nth-child(3) {
    background: #28c840;
  }
  .dots em {
    margin-left: 10px;
    font-style: normal;
    font-size: 0.75rem;
    color: #8d8da3;
  }
  pre {
    margin: 0;
    padding: 18px 20px 22px;
    font-size: 0.86rem;
    line-height: 1.7;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .c {
    color: #8d8da3;
  }
  .u {
    color: #22d3ee;
  }
  .a {
    color: #fbbf24;
  }
  .p {
    color: #a78bfa;
  }
  .cursor {
    color: #a78bfa;
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
  }
  .cta {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: 40px;
  }
  .hint {
    font-size: 0.8rem;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
</style>

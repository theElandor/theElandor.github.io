---
import { getEntry, render } from 'astro:content';
import Article from '../layouts/Article.astro';

const page = (await getEntry('pages', 'htb'))!;
const { Content } = await render(page);
---
<Article title={page.data.title} eyebrow="Security" back={{ href: '/posts/', label: 'All posts' }}>
  <Content />
</Article>

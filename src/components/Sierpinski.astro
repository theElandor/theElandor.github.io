---
// Real-time Sierpiński gasket. It is first constructed step by step with lines (2D canvas),
// then crossfades into a per-pixel WebGL render that dives forever into a self-similar
// point of the fractal (the loop is seamless, so float precision never runs out).
---
<canvas class="sierpinski" aria-hidden="true"></canvas>
<canvas class="sierpinski construction" aria-hidden="true"></canvas>

<style>
  .sierpinski {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  const VERT = `
    attribute vec2 a;
    void main() { gl_Position = vec4(a, 0.0, 1.0); }
  `;

  const FRAG = `
    #ifdef GL_FRAGMENT_PRECISION_HIGH
    precision highp float;
    #else
    precision mediump float;
    #endif
    uniform vec2 uRes;
    uniform vec2 uCenter;
    uniform float uHalfH;
    uniform float uZoom;
    uniform float uTime;
    uniform float uFade;
    uniform vec2 uMouse;
    uniform float uLight;
    uniform float uShift;

    const float H = 0.8660254;

    vec3 ramp(float t) {
      t = fract(t) * 3.0;
      vec3 a = vec3(0.545, 0.361, 0.965); // violet
      vec3 b = vec3(0.133, 0.827, 0.933); // cyan
      vec3 c = vec3(0.984, 0.749, 0.141); // amber
      if (t < 1.0) return mix(a, b, smoothstep(0.0, 1.0, t));
      if (t < 2.0) return mix(b, c, smoothstep(0.0, 1.0, t - 1.0));
      return mix(c, a, smoothstep(0.0, 1.0, t - 2.0));
    }

    float hash(vec2 p) { return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }

    void main() {
      vec2 uv = (gl_FragCoord.xy - 0.5 * uRes) / uRes.y;
      vec2 p = uCenter + (uv - vec2(uShift, 0.0)) * 2.0 * uHalfH;
      float pw = 2.0 * uHalfH / uRes.y;

      vec3 bgDark = vec3(0.035, 0.035, 0.063);
      vec3 bgLight = vec3(0.976, 0.973, 0.961);
      vec3 bg = mix(bgDark, bgLight, uLight);
      vec3 ink = mix(vec3(0.93, 0.93, 1.0), vec3(0.08, 0.08, 0.14), uLight);

      float v = p.y / H;
      float u = p.x - 0.5 * v;
      float dOut = max(max(-u, -v), u + v - 1.0) * H;

      // mouse spotlight
      float md = length(gl_FragCoord.xy - uMouse) / uRes.y;
      float spot = uMouse.x < 0.0 ? 0.0 : exp(-md * md * 9.0);

      vec3 col;
      if (dOut > 0.0) {
        float glow = exp(-dOut / 0.05);
        col = bg + ramp(uTime * 0.03) * glow * mix(0.16, 0.08, uLight);
        col = mix(ink, col, smoothstep(0.0, pw * 1.5, dOut));
      } else {
        float scale = 1.0;
        float holeK = -1.0;
        float dLocal = 0.0;
        for (int i = 0; i < 30; i++) {
          if (scale < pw * 1.5) break;
          u *= 2.0; v *= 2.0; scale *= 0.5;
          if (u >= 1.0) { u -= 1.0; }
          else if (v >= 1.0) { v -= 1.0; }
          else if (u + v > 1.0) {
            holeK = float(i);
            dLocal = min(min(1.0 - u, 1.0 - v), u + v - 1.0);
            break;
          }
        }

        float rel = holeK - uZoom;
        vec3 tint = ramp(rel * 0.11 + uTime * 0.025);
        vec3 line = mix(ink, tint, 0.45 + 0.25 * uLight);

        // Average look of structure too small to resolve (level-of-detail target).
        vec3 dust = mix(bg, mix(ink, ramp(uTime * 0.025 + 0.5), 0.5), mix(0.22, 0.3, uLight));
        if (holeK < 0.0) {
          col = dust;
        } else {
          float dW = dLocal * scale * H * 2.0;
          float inside = smoothstep(0.0, pw * 1.4, dW);
          float size = clamp(1.0 - rel * 0.07, 0.25, 1.0);
          float rim = exp(-dLocal * 10.0) * size;
          float fill = exp(-dLocal * 2.4) * 0.06 * size;
          vec3 hole = bg + tint * (rim * 0.55 + fill) * (1.0 + spot * 1.4);
          if (uLight > 0.5) hole = bg - (vec3(1.0) - tint) * (rim * 0.5 + fill);
          vec3 c = mix(line, hole, inside);
          // Fade holes that are only a few pixels wide into the dust tone (no shimmer).
          col = mix(dust, c, smoothstep(pw * 2.0, pw * 7.0, scale));
        }
      }

      // Fade in after the construction intro.
      col = mix(bg, col, uFade);

      // vignette + grain (kills banding)
      float vig = 1.0 - 0.35 * dot(uv * vec2(0.8, 1.0), uv * vec2(0.8, 1.0));
      col *= mix(vig, 1.0, uLight * 0.7);
      col += (hash(gl_FragCoord.xy + fract(uTime)) - 0.5) * 0.012;
      gl_FragColor = vec4(col, 1.0);
    }
  `;

  const H = Math.sqrt(3) / 2;
  // Fixed point of f_L ∘ f_R ∘ f_T: zooming by 8x around it reproduces the same picture.
  const P = { x: 2.5 / 7, y: H / 7 };
  // Intro camera: the middle of the triangle's bounding box, so all three corners are on screen.
  const VIEW_CENTER = { x: 0.5, y: H / 2 };
  const EDGE_MARGIN = 0.112; // distance from P to the nearest edge is H/7 ≈ 0.124
  const OCTAVES_PER_SECOND = 0.2;

  // Intro timeline: the outline is traced, then each step cuts the middle out of every
  // triangle (drawn as a wave from the top), then a crossfade to the shader and the endless zoom.
  const LEVELS = 7;
  const OUTLINE_SECONDS = 1.4;
  const LEVEL_SECONDS = [1.25, 1.15, 1.05, 1.0, 0.95, 0.95, 0.95];
  const HOLD_SECONDS = 0.6;
  const LEVEL_START = LEVEL_SECONDS.reduce((acc, d) => [...acc, acc[acc.length - 1] + d], [OUTLINE_SECONDS]);
  const BUILD_SECONDS = LEVEL_START[LEVELS] + HOLD_SECONDS;
  const FADE_SECONDS = 1.6;
  const ZOOM_START = BUILD_SECONDS + FADE_SECONDS + 0.4;
  const FILL_SECONDS = 0.5; // how long a hole takes to tint in once its outline is closed

  type Pt = { x: number; y: number };
  const VERTICES: Pt[] = [
    { x: 0, y: 0 },
    { x: 1, y: 0 },
    { x: 0.5, y: H },
  ];
  // violet → cyan → amber, the same palette as the shader
  const COLORS = {
    dark: { ink: [237, 237, 255], ramp: [[167, 139, 250], [34, 211, 238], [251, 191, 36]] },
    light: { ink: [20, 20, 36], ramp: [[109, 40, 217], [14, 116, 144], [180, 83, 9]] },
  };

  const smooth = (t: number) => t * t * (3 - 2 * t);
  const clamp01 = (t: number) => Math.min(1, Math.max(0, t));
  const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
  const mid = (a: Pt, b: Pt): Pt => ({ x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 });

  /** Colour of a construction level: walks along the palette, leaning towards the ink colour. */
  function levelColor(level: number, light: boolean) {
    const { ink, ramp } = light ? COLORS.light : COLORS.dark;
    const s = (level / LEVELS) * 2;
    const i = Math.min(1, Math.floor(s));
    const k = smooth(s - i);
    const tint = ramp[i].map((c, j) => c + (ramp[i + 1][j] - c) * k);
    const towardsInk = level === 0 ? 0.25 : 0.45;
    return tint.map((c, j) => Math.round(c + (ink[j] - c) * towardsInk));
  }

  type Hole = { pts: [Pt, Pt, Pt]; start: number; dur: number };

  // Every hole of the first LEVELS steps, with when its pen starts and how long it takes.
  const HOLES: Hole[][] = [];
  {
    let tris: [Pt, Pt, Pt][] = [[VERTICES[0], VERTICES[1], VERTICES[2]]];
    const top = VERTICES[2];
    for (let level = 1; level <= LEVELS; level++) {
      const next: [Pt, Pt, Pt][] = [];
      const holes: { pts: [Pt, Pt, Pt]; key: number }[] = [];
      for (const [a, b, c] of tris) {
        const ab = mid(a, b), bc = mid(b, c), ca = mid(c, a);
        const cx = (ab.x + bc.x + ca.x) / 3, cy = (ab.y + bc.y + ca.y) / 3;
        // left-middle → right-middle → bottom-middle: a tidy pen order for the upside-down hole
        holes.push({ pts: [ca, bc, ab], key: Math.hypot(cx - top.x, cy - top.y) });
        next.push([a, ab, ca], [ab, b, bc], [ca, bc, c]);
      }
      const maxKey = Math.max(...holes.map((h) => h.key), 1e-9);
      const span = LEVEL_SECONDS[level - 1];
      const dur = level <= 2 ? span * 0.75 : Math.min(0.6, span * 0.55);
      HOLES.push(holes.map((h) => ({ pts: h.pts, dur, start: LEVEL_START[level - 1] + (h.key / maxKey) * (span - dur) })));
      tris = next;
    }
  }

  type View = { cx: number; cy: number; half: number; shift: number };

  /** Draws the step-by-step construction of the gasket, with lines only. */
  class Construction {
    ctx: CanvasRenderingContext2D;
    w = 0;
    h = 0;
    dpr = 1;
    view: View = { cx: 0, cy: 0, half: 1, shift: 0 };
    light = false;

    constructor(public canvas: HTMLCanvasElement) {
      this.ctx = canvas.getContext('2d')!;
    }

    toScreen(p: Pt): [number, number] {
      const { cx, cy, half, shift } = this.view;
      return [this.w / 2 + ((p.x - cx) / (2 * half) + shift) * this.h, this.h / 2 - ((p.y - cy) / (2 * half)) * this.h];
    }

    setup(view: View, light: boolean) {
      const r = this.canvas.getBoundingClientRect();
      this.dpr = Math.min(window.devicePixelRatio || 1, 2);
      this.w = Math.max(1, r.width);
      this.h = Math.max(1, r.height);
      const cw = Math.round(this.w * this.dpr), ch = Math.round(this.h * this.dpr);
      if (this.canvas.width !== cw || this.canvas.height !== ch) {
        this.canvas.width = cw;
        this.canvas.height = ch;
      }
      this.view = view;
      this.light = light;
    }

    /** Adds the polyline `pts` up to fraction `p` of its length to the current path; returns the pen tip. */
    trace(pts: [number, number][], p: number): [number, number] {
      const { ctx } = this;
      const lens = pts.slice(1).map((q, i) => Math.hypot(q[0] - pts[i][0], q[1] - pts[i][1]));
      let left = p * lens.reduce((s, l) => s + l, 0);
      ctx.moveTo(pts[0][0], pts[0][1]);
      let tip = pts[0];
      for (let i = 0; i < lens.length && left > 0; i++) {
        const k = Math.min(1, left / Math.max(lens[i], 1e-9));
        tip = [pts[i][0] + (pts[i + 1][0] - pts[i][0]) * k, pts[i][1] + (pts[i + 1][1] - pts[i][1]) * k];
        ctx.lineTo(tip[0], tip[1]);
        left -= lens[i];
      }
      return tip;
    }

    /** Draws the construction at time t; returns the deepest step that has started. */
    draw(t: number): number {
      const { ctx, light } = this;
      ctx.setTransform(this.dpr, 0, 0, this.dpr, 0, 0);
      ctx.clearRect(0, 0, this.w, this.h);
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      const rgba = (c: number[], a: number) => `rgba(${c[0]},${c[1]},${c[2]},${a})`;
      const tips: { at: [number, number]; color: number[]; a: number }[] = [];

      // The starting triangle, traced by two pens from the top corner down both sides.
      const [A, B, C] = VERTICES.map((v) => this.toScreen(v));
      const bottom: [number, number] = [(A[0] + B[0]) / 2, (A[1] + B[1]) / 2];
      const po = easeInOut(clamp01(t / OUTLINE_SECONDS));
      const outline = levelColor(0, light);
      ctx.lineWidth = 1.8;
      ctx.strokeStyle = rgba(outline, 0.95);
      ctx.shadowColor = rgba(outline, light ? 0 : 0.6);
      ctx.shadowBlur = 12;
      ctx.beginPath();
      const tl = this.trace([C, A, bottom], po);
      const tr = this.trace([C, B, bottom], po);
      ctx.stroke();
      ctx.shadowBlur = 0;
      if (po < 1) tips.push({ at: tl, color: outline, a: 1 }, { at: tr, color: outline, a: 1 });

      let deepest = 0;
      HOLES.forEach((holes, i) => {
        const level = i + 1;
        if (t < LEVEL_START[i]) return;
        deepest = level;
        const color = levelColor(level, light);
        const lineA = Math.max(0.45, 0.95 - level * 0.06);
        const fillA = (light ? 0.1 : 0.14) * Math.pow(0.82, level - 1);
        ctx.lineWidth = Math.max(0.55, 1.6 * Math.pow(0.8, level));
        ctx.strokeStyle = rgba(color, lineA);

        // Closed holes are batched into one path per level; fully tinted ones share one fill.
        const closed = new Path2D();
        const settled = new Path2D();
        for (const hole of holes) {
          const p = (t - hole.start) / hole.dur;
          if (p <= 0) continue;
          const pts = hole.pts.map((q) => this.toScreen(q));
          if (p < 1) {
            ctx.beginPath();
            const tip = this.trace([...pts, pts[0]], easeInOut(p));
            ctx.stroke();
            if (level <= 3) tips.push({ at: tip, color, a: Math.sin(Math.PI * p) });
            continue;
          }
          const tri = new Path2D();
          tri.moveTo(pts[0][0], pts[0][1]);
          tri.lineTo(pts[1][0], pts[1][1]);
          tri.lineTo(pts[2][0], pts[2][1]);
          tri.closePath();
          closed.addPath(tri);
          const f = smooth(clamp01(((p - 1) * hole.dur) / FILL_SECONDS));
          if (f >= 1) {
            settled.addPath(tri);
          } else {
            ctx.fillStyle = rgba(color, fillA * f);
            ctx.fill(tri);
          }
        }
        ctx.fillStyle = rgba(color, fillA);
        ctx.fill(settled);
        ctx.stroke(closed);
      });

      // Glowing pen tips.
      for (const { at, color, a } of tips) {
        ctx.fillStyle = rgba(color, 0.25 * a);
        ctx.beginPath(); ctx.arc(at[0], at[1], 7, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = rgba(color, a);
        ctx.beginPath(); ctx.arc(at[0], at[1], 2.4, 0, Math.PI * 2); ctx.fill();
      }
      return deepest;
    }
  }

  function init(canvas: HTMLCanvasElement, buildCanvas: HTMLCanvasElement) {
    const gl = canvas.getContext('webgl', { antialias: false, alpha: false, powerPreference: 'high-performance' });
    if (!gl) {
      buildCanvas.remove();
      return fallback(canvas);
    }

    const compile = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s) ?? 'shader');
      return s;
    };
    const prog = gl.createProgram()!;
    try {
      gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERT));
      gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAG));
      gl.linkProgram(prog);
    } catch (e) {
      console.warn(e);
      buildCanvas.remove();
      return fallback(canvas);
    }
    gl.useProgram(prog);
    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'a');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const U = Object.fromEntries(
      ['uRes', 'uCenter', 'uHalfH', 'uZoom', 'uTime', 'uFade', 'uMouse', 'uLight', 'uShift'].map((n) => [n, gl.getUniformLocation(prog, n)]),
    );

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let quality = Math.min(window.devicePixelRatio || 1, 2);
    let w = 0, h = 0, aspect = 1;
    const resize = () => {
      const r = canvas.getBoundingClientRect();
      aspect = r.width / Math.max(1, r.height);
      w = Math.max(1, Math.round(r.width * quality));
      h = Math.max(1, Math.round(r.height * quality));
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w;
        canvas.height = h;
        gl.viewport(0, 0, w, h);
      }
    };

    const mouse = { x: -1, y: -1, tx: 0, ty: 0, px: 0, py: 0 };
    const onMove = (e: PointerEvent) => {
      const r = canvas.getBoundingClientRect();
      mouse.x = (e.clientX - r.left) * quality;
      mouse.y = (r.bottom - e.clientY) * quality;
      mouse.tx = (e.clientX - r.left) / r.width - 0.5;
      mouse.ty = 0.5 - (e.clientY - r.top) / r.height;
    };
    window.addEventListener('pointermove', onMove, { passive: true });

    const isLight = () => document.documentElement.dataset.theme === 'light';

    const build = new Construction(buildCanvas);
    const caption = document.querySelector<HTMLElement>('[data-fractal-caption]');
    const captionText = caption?.textContent ?? '';
    let buildDone = reduced;
    if (reduced) buildCanvas.remove();

    let start = performance.now();
    let last = start;
    let visible = true;
    let raf = 0;
    let slowFrames = 0;

    const frame = (now: number) => {
      raf = 0;
      const dt = now - last;
      last = now;
      // Adaptive resolution: keep it fluid on slow GPUs.
      if (dt > 24 && dt < 200) slowFrames++;
      else slowFrames = Math.max(0, slowFrames - 1);
      if (slowFrames > 20 && quality > 0.5) {
        quality = Math.max(0.5, quality * 0.8);
        slowFrames = 0;
      }
      resize();

      const t = reduced ? 1e3 : (now - start) / 1000;
      // On wide screens the triangle sits to the right of the hero text.
      const shift = aspect > 1.15 ? Math.min(0.19 * aspect, 0.4) : 0;
      const halfFull = Math.max(0.56, 0.6 / aspect);
      // Farthest visible point from the zoom target, in units of the view's half-height.
      const reach = 2 * Math.hypot(aspect / 2 + shift, 0.5);
      const zLoop = Math.max(0, Math.log2((halfFull * reach * 1.08) / EDGE_MARGIN));

      const z = reduced ? 0 : Math.max(0, t - ZOOM_START) * OCTAVES_PER_SECOND;
      let zEff = z;
      let cx: number, cy: number;
      if (z < zLoop) {
        const k = smooth(Math.min(1, z / zLoop));
        cx = VIEW_CENTER.x + (P.x - VIEW_CENTER.x) * k;
        cy = VIEW_CENTER.y + (P.y - VIEW_CENTER.y) * k;
      } else {
        zEff = zLoop + ((z - zLoop) % 3);
        cx = P.x;
        cy = P.y;
      }
      const half = halfFull * Math.pow(2, -zEff);
      // Gentle parallax, proportional to the view so the loop stays seamless.
      mouse.px += (mouse.tx - mouse.px) * 0.04;
      mouse.py += (mouse.ty - mouse.py) * 0.04;
      const parallax = reduced ? 0 : smooth(clamp01((t - ZOOM_START) / 2));
      cx += mouse.px * half * 0.06 * parallax;
      cy += mouse.py * half * 0.06 * parallax;

      const fade = reduced ? 1 : smooth(clamp01((t - BUILD_SECONDS) / FADE_SECONDS));
      if (!buildDone) {
        if (fade >= 1) {
          buildDone = true;
          buildCanvas.remove();
          if (caption) caption.textContent = captionText;
        } else {
          // Same camera as the shader at z = 0, so the crossfade lines up exactly.
          build.setup({ cx: VIEW_CENTER.x, cy: VIEW_CENTER.y, half: halfFull, shift }, isLight());
          const step = build.draw(t);
          buildCanvas.style.opacity = String(1 - fade);
          if (caption) {
            caption.textContent = step === 0
              ? 'Sierpiński construction · start with a triangle'
              : `Sierpiński construction · step ${step}: cut out the middle · ${(3 ** step).toLocaleString('en-US')} triangles`;
          }
        }
      }

      gl.uniform2f(U.uRes, w, h);
      gl.uniform2f(U.uCenter, cx, cy);
      gl.uniform1f(U.uHalfH, half);
      gl.uniform1f(U.uZoom, zEff);
      gl.uniform1f(U.uTime, reduced ? 0 : t);
      gl.uniform1f(U.uFade, fade);
      gl.uniform2f(U.uMouse, mouse.x, mouse.y);
      gl.uniform1f(U.uLight, isLight() ? 1 : 0);
      gl.uniform1f(U.uShift, shift);
      gl.drawArrays(gl.TRIANGLES, 0, 3);

      if (!reduced && visible) raf = requestAnimationFrame(frame);
    };
    const kick = () => { if (!raf) { last = performance.now(); raf = requestAnimationFrame(frame); } };

    new IntersectionObserver(([entry]) => {
      const wasVisible = visible;
      visible = entry.isIntersecting;
      if (visible && !wasVisible) {
        // resume where we left off
        const paused = performance.now() - last;
        start += paused;
        kick();
      }
    }).observe(canvas);
    new ResizeObserver(kick).observe(canvas);
    new MutationObserver(kick).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    kick();
  }

  // Canvas 2D fallback when WebGL is unavailable: a static gasket.
  function fallback(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const draw = () => {
      const r = canvas.getBoundingClientRect();
      canvas.width = r.width;
      canvas.height = r.height;
      const s = Math.min(r.width, r.height / H) * 0.8;
      const ox = (r.width - s) / 2, oy = (r.height + s * H) / 2;
      ctx.fillStyle = getComputedStyle(document.documentElement).getPropertyValue('--bg') || '#09090f';
      ctx.fillRect(0, 0, r.width, r.height);
      ctx.strokeStyle = '#8b5cf6';
      ctx.lineWidth = 1;
      const tri = (x: number, y: number, size: number, d: number) => {
        if (d === 0) {
          ctx.beginPath();
          ctx.moveTo(x, y); ctx.lineTo(x + size, y); ctx.lineTo(x + size / 2, y - size * H); ctx.closePath();
          ctx.stroke();
          return;
        }
        const h2 = size / 2;
        tri(x, y, h2, d - 1); tri(x + h2, y, h2, d - 1); tri(x + h2 / 2, y - h2 * H, h2, d - 1);
      };
      tri(ox, oy, s, 6);
    };
    draw();
    new ResizeObserver(draw).observe(canvas);
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas.sierpinski:not(.construction)').forEach((c) =>
    init(c, c.nextElementSibling as HTMLCanvasElement),
  );
</script>

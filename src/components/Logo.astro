---
// Level-2 Sierpiński triangle.
const { size = 26 } = Astro.props;
---
<svg class="logo" width={size} height={size * 0.875} viewBox="0 0 32 28" aria-hidden="true">
  <defs>
    <linearGradient id="logo-g" x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" stop-color="#8b5cf6" />
      <stop offset="0.55" stop-color="#22d3ee" />
      <stop offset="1" stop-color="#fbbf24" />
    </linearGradient>
  </defs>
  <path
    fill="url(#logo-g)"
    fill-rule="evenodd"
    d="M16 0 32 28H0Z M8 14H24L16 28Z M12 7H20L16 14Z M4 21H12L8 28Z M20 21H28L24 28Z"
  />
</svg>
